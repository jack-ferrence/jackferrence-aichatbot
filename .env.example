# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/atlas_chat?schema=public"

# Anthropic API key. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model to use for chat completions.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Secret used by Auth.js to sign session tokens/cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Base URL of the app when running locally.
NEXTAUTH_URL=http://localhost:3000
